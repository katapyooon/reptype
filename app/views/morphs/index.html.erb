<% content_for :title, "モルフ図鑑" %>

<div class="morphs-wrapper">
  <h1>モルフ図鑑</h1>
  <p>レオパードゲッコーのモルフ(品種)を紹介します。</p>

  <% if @error %>
    <p style="color: #a10000;">図鑑APIに接続できませんでした。しばらくしてから再度お試しください。</p>
  <% elsif @morphs.blank? %>
    <p>モルフが登録されていません。</p>
  <% else %>
    <div class="morph-grid">
      <% @morphs.each do |morph| %>
        <%= link_to morph_path(morph["code"]), class: "morph-card" do %>
          <h3><%= morph["name"] %></h3>
          <p><%= morph["description"] %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
